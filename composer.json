{
    "name": "nonini/cli",
    "description": "CLI utilities",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Gelf",
            "email": "thomas@gelf.net"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "nonini\\Cli\\": "src"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "react/stream": ">=1.1",
        "react/promise": "^2|^3"
    },
    "require-dev": {
        "react/child-process": ">=0.6",
        "phpstan/phpstan": "^1.10 || ^2",
        "phpunit/phpunit": "^10.3 || ^13",
        "squizlabs/php_codesniffer": "^3.7 || ^4",
        "symplify/easy-coding-standard": "^12.0.8 || ^13"
    }
}
